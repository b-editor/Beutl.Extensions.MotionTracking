<Project Sdk="Beutl.Extensibility.Sdk/2.0.0-preview.14">

    <PropertyGroup>
        <PackageId>Beutl.Extensions.MotionTracking</PackageId>
        <Title>Motion tracking</Title>
        <Description>Track points in a video and apply their motion to objects as keyframes, or stabilize shaky footage.</Description>
        <PackageTags>motion,tracking,tracker,stabilize,モーショントラッキング,トラッキング,追跡,スタビライズ,手ブレ補正</PackageTags>
        <Version>0.1.1</Version>
        <AssemblyVersion>0.1.1.0</AssemblyVersion>
        <Authors>Yuto Terada</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <BeutlAutoReferenceSourceGenerators>false</BeutlAutoReferenceSourceGenerators>
        <NeutralLanguage>en</NeutralLanguage>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Beutl.Extensions.MotionTracking.Tests" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties/Strings.resx">
            <StronglyTypedLanguage>C#</StronglyTypedLanguage>
            <StronglyTypedNamespace>Beutl.Extensions.MotionTracking.Properties</StronglyTypedNamespace>
            <StronglyTypedClassName>Strings</StronglyTypedClassName>
            <StronglyTypedFileName>$(IntermediateOutputPath)Strings.g.cs</StronglyTypedFileName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <!-- The icons Beutl's own tool tabs use. The SDK compiles against the version Beutl ships and leaves the
             library, and what it pulls in (such as native SkiaSharp), out of the output: at run time the extension
             uses Beutl's copies. FluentIcons.Common and FluentIcons.Resources.Avalonia come with it, at the version
             it pins. -->
        <BeutlHostPackageReference Include="FluentIcons.Avalonia.Fluent" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
</Project>
